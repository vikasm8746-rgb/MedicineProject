{
  "info": {
    "name": "MediFind API Collection",
    "description": "Complete REST API collection for MediFind - Medicine Availability Finder",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Amit Kumar\",\n  \"email\": \"amit@example.com\",\n  \"phone\": \"+91 9123456780\",\n  \"password\": \"password123\",\n  \"role\": \"user\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rahul@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login Pharmacy Owner",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sunita@apexpharma.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/profile", "host": ["{{baseUrl}}"], "path": ["auth", "profile"] }
          }
        }
      ]
    },
    {
      "name": "Medicines",
      "item": [
        {
          "name": "List Medicines (All)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/medicines", "host": ["{{baseUrl}}"], "path": ["medicines"] }
          }
        },
        {
          "name": "Search Medicines",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/medicines/search?query=paracetamol",
              "host": ["{{baseUrl}}"],
              "path": ["medicines", "search"],
              "query": [{ "key": "query", "value": "paracetamol" }]
            }
          }
        },
        {
          "name": "Get Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/medicines/categories", "host": ["{{baseUrl}}"], "path": ["medicines", "categories"] }
          }
        },
        {
          "name": "Get Popular Medicines",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/medicines/popular", "host": ["{{baseUrl}}"], "path": ["medicines", "popular"] }
          }
        },
        {
          "name": "Get Medicine Details & Stocking Pharmacies",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/medicines/1", "host": ["{{baseUrl}}"], "path": ["medicines", "1"] }
          }
        }
      ]
    },
    {
      "name": "Pharmacies",
      "item": [
        {
          "name": "List Pharmacies",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/pharmacies", "host": ["{{baseUrl}}"], "path": ["pharmacies"] }
          }
        },
        {
          "name": "Get Pharmacy by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/pharmacies/1", "host": ["{{baseUrl}}"], "path": ["pharmacies", "1"] }
          }
        },
        {
          "name": "Get In-Store Medicines",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/pharmacies/1/medicines", "host": ["{{baseUrl}}"], "path": ["pharmacies", "1", "medicines"] }
          }
        }
      ]
    },
    {
      "name": "Reservations",
      "item": [
        {
          "name": "Create Reservation Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pharmacy_id\": 1,\n  \"medicine_id\": 1,\n  \"quantity\": 2,\n  \"notes\": \"Urgent emergency pickup at 6 PM\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/reservations", "host": ["{{baseUrl}}"], "path": ["reservations"] }
          }
        },
        {
          "name": "Get My Reservations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/reservations/my", "host": ["{{baseUrl}}"], "path": ["reservations", "my"] }
          }
        },
        {
          "name": "Get Pharmacy Orders (Owner)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/reservations/pharmacy", "host": ["{{baseUrl}}"], "path": ["reservations", "pharmacy"] }
          }
        },
        {
          "name": "Update Reservation Status (Owner)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Accepted\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/reservations/1/status", "host": ["{{baseUrl}}"], "path": ["reservations", "1", "status"] }
          }
        }
      ]
    },
    {
      "name": "Inventory (Owner)",
      "item": [
        {
          "name": "Get Owner Inventory",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/inventory/my", "host": ["{{baseUrl}}"], "path": ["inventory", "my"] }
          }
        },
        {
          "name": "Get Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/inventory/stats", "host": ["{{baseUrl}}"], "path": ["inventory", "stats"] }
          }
        },
        {
          "name": "Add Medicine to Inventory",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cetirizine 10mg\",\n  \"brand_name\": \"Cetzine\",\n  \"generic_name\": \"Cetirizine Hydrochloride\",\n  \"category\": \"Cold & Cough\",\n  \"manufacturer\": \"Dr. Reddy's\",\n  \"quantity\": 75,\n  \"price\": 22.50,\n  \"expiry_date\": \"2027-10-15\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/inventory", "host": ["{{baseUrl}}"], "path": ["inventory"] }
          }
        }
      ]
    }
  ]
}

